# Example only: no credentials are required or stored here.
MD2DOCX_HOST=127.0.0.1
MD2DOCX_PORT=8000
MD2DOCX_DATA_DIR=/var/lib/md2docx
MD2DOCX_ORIGINS=https://your-web.example
MD2DOCX_COOKIE_SECURE=1
MD2DOCX_MAX_QUEUE=8
MD2DOCX_MAX_ACTIVE_PER_SESSION=2
MD2DOCX_FILE_TIMEOUT=60
MD2DOCX_JOB_TIMEOUT=180
MD2DOCX_QUEUE_TIMEOUT=300
MD2DOCX_RETENTION_SECONDS=86400
MD2DOCX_MAX_STORAGE_BYTES=536870912
MD2DOCX_MIN_FREE_BYTES=268435456
